# ── Required ────────────────────────────────────────────────────────────────
PORT=8000
MONGO_URI=mongodb://localhost:27017/pulsequiz

# Must be >= 32 chars, different from each other, and NOT these placeholders.
# The server refuses to start otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# ── Sessions ────────────────────────────────────────────────────────────────
# Access tokens are short-lived and carry a token-version claim, so logout and
# ban revoke them immediately. The client refreshes via POST /api/auth/refresh.
# JWT_EXPIRES_IN=30d
# JWT_REFRESH_EXPIRES_IN=180d
#
# Tokens issued before versioning existed had a ten-year expiry and no version
# claim, so bumping tokenVersion cannot revoke them. They are still accepted,
# and GET /api/auth/me swaps each one for a modern pair on first use. Once the
# fleet has rolled over (give it a few weeks), set this to 1 to refuse them.
# REJECT_LEGACY_TOKENS=0

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. In production this MUST be an explicit list;
# the server refuses to boot with "*" or an empty value.
FRONTEND_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of the app. Too high and a client can
# spoof X-Forwarded-For to bypass IP rate limits; too low and rate limiting
# keys on the proxy instead of the client.
TRUST_PROXY_HOPS=1

# ── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Sign in with Apple — required by App Store guideline 4.8 when other
# third-party logins are offered. Comma-separated; defaults to APPLE_BUNDLE_ID.
APPLE_CLIENT_IDS=

# ── Apple IAP (App Store Server API) ────────────────────────────────────────
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.bonhomie95.pulsequiz
# Base64 DER of Apple Root CA G3, used to anchor webhook signature chains.
# Required in production. Download from https://www.apple.com/certificateauthority/
APPLE_ROOT_CA_G3=

# ── Google IAP ──────────────────────────────────────────────────────────────
# Full service-account JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.bonhomie95.pulsequiz

# Real-Time Developer Notifications (refunds, renewals). Either verify the
# Pub/Sub OIDC token, or fall back to a shared secret in the callback URL.
PUBSUB_VERIFICATION_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_RTDN_SECRET=

# ── AdMob server-side verification ──────────────────────────────────────────
# Set to 1 in production. Required — the server refuses to boot without it,
# because with it off, rewarded-ad coins are minted on the client's word alone.
# Point the ad unit's SSV callback at:
#   https://<your-host>/api/webhooks/admob/ssv
ADMOB_SSV_ENABLED=0
# AD_REWARD_COOLDOWN_MS=30000

# ── Payouts (NOWPayments) ───────────────────────────────────────────────────
# The mass-payout API needs a bearer token from /v1/auth in addition to the
# API key, and 2FA verification per batch. Without a key, payouts FAIL loudly
# rather than being marked sent.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_2FA_CODE=
NOWPAYMENTS_IPN_URL=
# Local development only — simulates successful payouts. NEVER set in production.
PAYOUT_MOCK=0
# Hours a changed payout address must age before it can receive money.
PAYOUT_ADDRESS_HOLD_HOURS=72

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
LOG_PRETTY=1
# Bearer token guarding /metrics. Leave unset to expose it unauthenticated
# (only safe when the endpoint is not reachable from the internet).
METRICS_TOKEN=
APP_VERSION=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to 0 on web replicas so only the dedicated worker runs scheduled jobs.
# Jobs also take a distributed lock, so this is belt and braces.
RUN_CRON=1
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5
SHUTDOWN_TIMEOUT_MS=15000
SETTINGS_CACHE_TTL_MS=60000
# Fallback day boundary for streaks when the client doesn't send its timezone.
DEFAULT_STREAK_TZ=UTC
CHALLENGE_TZ=UTC

# ── Rate limits (optional, defaults in code) ────────────────────────────────
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_ADMIN_LOGIN_MAX=10
# RATE_LIMIT_OAUTH_MAX=30
# RATE_LIMIT_QUIZ_START_MAX=50
# RATE_LIMIT_PURCHASE_MAX=30
# RATE_LIMIT_SENSITIVE_MAX=60
# RATE_LIMIT_WEBHOOK_MAX=600
# RATE_LIMIT_ROOM_JOIN_MAX=20
# RATE_LIMIT_WALLET_UPDATE_MAX=5
