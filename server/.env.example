# ── Required ────────────────────────────────────────────────────────────────
PORT=8000
MONGO_URI=mongodb://localhost:27017/pulsequiz
JWT_SECRET=change-me-64-random-chars
ADMIN_JWT_SECRET=change-me-different-64-random-chars

# ── OAuth ───────────────────────────────────────────────────────────────────
# Comma-separated list of accepted Google client IDs (web, android, ios)
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins; "*" or empty allows all (dev only)
FRONTEND_ORIGIN=*

# ── Apple IAP (App Store Server API) ────────────────────────────────────────
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.bonhomie95.pulsequiz

# ── Google IAP ──────────────────────────────────────────────────────────────
# Full service-account JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# Trusted package name — server ignores client-supplied values when set
ANDROID_PACKAGE_NAME=com.bonhomie95.pulsequiz

# ── Payouts ─────────────────────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_URL=

# ── Tuning (optional, defaults in code) ─────────────────────────────────────
# JWT_EXPIRES_IN=30d
# AD_REWARD_COOLDOWN_MS=30000
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_ADMIN_LOGIN_MAX=10
# RATE_LIMIT_OAUTH_MAX=30
# RATE_LIMIT_QUIZ_START_MAX=50
# RATE_LIMIT_PURCHASE_MAX=30
# RATE_LIMIT_SENSITIVE_MAX=60
