        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pulsequiz.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
