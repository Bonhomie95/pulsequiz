{
  "expo": {
    "name": "Pulse Quiz",
    "slug": "pulsequiz",
    "version": "1.0.0",
    "scheme": "pulsequiz",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bonhomie95.pulsequiz",
      "associatedDomains": [
        "applinks:pulsequiz.app"
      ],
      "infoPlist": {
        "NSUserNotificationUsageDescription": "PulseQuiz sends you streak reminders, prize alerts, and challenge notifications.",
        "NSUserTrackingUsageDescription": "This lets us show ads that are more relevant to you. Your data is never sold."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bonhomie95.pulsequiz",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "android.permission.INTERNET",
        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pulsequiz.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.924123058946-rk6hn6iuf8fmitpsi8jsjfpk47cjucni"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3226169062425843~7059881649",
          "iosAppId": "ca-app-pub-7561090708148190~8055600243",
          "userTrackingUsageDescription": "This lets us show ads that are more relevant to you. Your data is never sold."
        }
      ],
      "@sentry/react-native/expo",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "91e7781d-86d2-4fcd-b570-087289350411"
      }
    },
    "owner": "bonhomie95"
  }
}
