# Copy to .env and fill in. Everything prefixed EXPO_PUBLIC_ is embedded in the
# app bundle and readable by anyone who downloads it — never put a secret here.

# ── API ─────────────────────────────────────────────────────────────────────
# Your machine's LAN IP for device testing, not localhost — the phone cannot
# reach your Mac's localhost. Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.100.62:8000/api

# ── OAuth ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# ── AdMob ───────────────────────────────────────────────────────────────────
# Test IDs are used automatically in development; these are the live units.
EXPO_PUBLIC_ADMOB_REWARDED_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=

# ── Crash reporting ─────────────────────────────────────────────────────────
# Without this, initSentry() is a no-op and you ship blind.
EXPO_PUBLIC_SENTRY_DSN=

# ── Sentry build-time (source map upload) ───────────────────────────────────
# NOT prefixed EXPO_PUBLIC_ — these are build credentials, not app config.
#
# app.config.js adds the @sentry/react-native/expo plugin ONLY when all three
# are set. That plugin installs an Xcode phase which shells out to sentry-cli,
# and sentry-cli hard-fails a build with no org:
#   error: An organization ID or slug is required (provide with --org)
#   "xcodebuild" exited with error code 65
# Leaving these blank is therefore a supported state: the build succeeds and
# only source-map upload is skipped.
#
# Runtime crash reporting is independent and driven by EXPO_PUBLIC_SENTRY_DSN
# above. Without upload, traces still arrive — just minified.
#
# Set all three, then re-run `npx expo prebuild --clean` for the phase to be
# added to the native project.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
